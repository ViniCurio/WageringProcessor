{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/src/main.js",
    "test": "bun test --path-ignore-patterns=\"dist/**\" tests",
    "test:integration": "bun test --path-ignore-patterns=\"dist/**\" tests/integration",
    "lint": "tsc --noEmit",
    "migration:up": "bun src/infrastructure/database/migrate.ts up",
    "migration:down": "bun src/infrastructure/database/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.879.0",
    "@mikro-orm/core": "^6.5.2",
    "@mikro-orm/migrations": "^6.5.2",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.5.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/node": "^22.18.0",
    "@types/express": "^5.0.3",
    "typescript": "^5.9.2"
  }
}
